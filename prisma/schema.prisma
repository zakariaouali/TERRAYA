// MySQL. The schema avoids native enums and array columns (stored as JSON
// strings) so it stays portable across MySQL/MariaDB/Postgres.
//
// Explicit @db.VarChar/@db.Text lengths matter here: MySQL/MariaDB truncate
// a plain `String` column (Prisma's default VARCHAR(191)) silently under
// non-strict SQL mode instead of erroring, so every field is sized to at
// least its Zod validation max in src/lib/validation.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(255)
  passwordHash String
  name         String?
  role         String     @default("VIEWER") // ADMIN | EDITOR | VIEWER
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Property {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String    @db.VarChar(255)
  tagline      String?   @db.VarChar(255)
  description  String    @db.Text
  type         String // VILLA | ESTATE | PENTHOUSE | RESIDENCE | RIAD | LAND
  listingType  String    @default("SALE") // SALE | RENT — long-term only, 6-month minimum on RENT
  status       String    @default("AVAILABLE") // DRAFT | AVAILABLE | RESERVED | SOLD
  location     String    @db.VarChar(255)
  city         String
  country      String
  priceEur     BigInt
  bedrooms     Int
  bathrooms    Int
  areaSqm      Int
  landSqm      Int?
  yieldPercent Float?
  featured     Boolean   @default(false)
  heroImage    String    @db.VarChar(600)
  images       String    @db.Text // JSON-encoded string[]
  amenities    String    @db.Text // JSON-encoded string[]
  highlights   String    @db.Text // JSON-encoded string[]
  features     String    @default("[]") @db.VarChar(500) // JSON string[] of keys from src/lib/features.ts
  latitude     Float?
  longitude    Float?
  brochureUrl  String?   @db.VarChar(600)
  videoUrl     String?   @db.VarChar(600)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inquiries    Inquiry[]

  @@index([status, featured])
  @@index([city])
  @@index([listingType, status])
  @@index([priceEur])
}

model Inquiry {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name       String
  email      String    @db.VarChar(255)
  phone      String?
  message    String    @db.Text
  budget     String?
  status     String    @default("NEW") // NEW | CONTACTED | QUALIFIED | CLOSED
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?  @db.Text // JSON-encoded object
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(255)
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ConsultationRequest {
  id        String   @id @default(cuid())
  name      String
  email     String   @db.VarChar(255)
  phone     String?
  date      String?
  time      String?
  message   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PropertyRequest {
  id           String   @id @default(cuid())
  name         String
  email        String   @db.VarChar(255)
  phone        String?
  listingType  String // SALE | RENT
  propertyType String? // VILLA | ESTATE | PENTHOUSE | RESIDENCE | RIAD | LAND — blank if undecided
  city         String?
  bedrooms     Int?
  minBudget    BigInt?
  maxBudget    BigInt?
  notes        String?  @db.Text
  status       String   @default("NEW") // NEW | CONTACTED | CLOSED
  ip           String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model ListingSubmission {
  id                  String   @id @default(cuid())
  name                String
  phone               String
  email               String   @db.VarChar(255)
  propertyType        String // VILLA | ESTATE | PENTHOUSE | RESIDENCE | RIAD | LAND
  listingType         String   @default("SALE") // SALE | RENT
  city                String
  images              String   @db.Text // JSON-encoded string[]
  status              String   @default("NEW") // NEW | CONTACTED | CONVERTED | DECLINED
  convertedPropertyId String?
  ip                  String?
  createdAt           DateTime @default(now())

  @@index([status, createdAt])
}
